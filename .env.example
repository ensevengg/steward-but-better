# STEWARD_OPENCODE_URL=http://127.0.0.1:4096
# STEWARD_MODEL_PROVIDER=your-provider
# STEWARD_MODEL_ID=your-explicit-model-version
# OPENCODE_SERVER_PASSWORD=your-local-server-password
